# Credential/session files that must never be committed. Capture scripts read these
# from each tool's real config location; none of them belong in this repo.
auth.json
oauth_creds.json
*.pem
*credentials*.json
.env
.env.*

# Scratch space used by the daily-refresh pipeline and local capture runs.
.capture-scratch/
capture-output/
driver-output/
*.capture.jsonl
artifacts/trace/
grok-capture.jsonl
capture.jsonl

# Codex's own upstream source clone (see codex/README.md and
# sync-codex-reference.sh) — a full foreign git history, deliberately never
# committed here. Synced fresh by the daily-refresh pipeline; a local copy can
# also be cloned manually for ad hoc extraction work.
references/
