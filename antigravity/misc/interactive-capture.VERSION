source = antigravity.google/cli
distribution = native Go binary
version = 1.1.14
platform = linux-x64
installer_url = https://antigravity.google/cli/install.sh
manifest_url = https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json
manifest_version = 1.1.14
manifest_tarball_url = https://storage.googleapis.com/antigravity-public/antigravity-cli/1.1.14-6392696810635264/linux-x64/cli_linux_x64.tar.gz
manifest_tarball_sha512 = 481f590b102ca6847ef13b865f08d457048a1f3f01851ed2a3818eb09a53264b107ca5e442a8677248d9790fd96eccf4918a2aed82d866b23d294422ba42f67e
auth_source = local Antigravity Google OAuth/keyring
trace_script = antigravity/misc/scripts/extract-antigravity-log.cjs
capture_mode = interactive
capture = tmux new-session with `CODEIUM_VMODULE='*=5' agy --add-dir "$PWD" --dangerously-skip-permissions --log-file <trace>/agy.log`, then send `Reply exactly: ANTIGRAVITY_INTERACTIVE_TRACE_OK`
endpoint = https://daily-cloudcode-pa.googleapis.com/v1internal:streamGenerateContent?alt=sse
response_model_versions = unknown
prompt_models = gemini-3.7-flash-high
prompts = 1
tools = 16
