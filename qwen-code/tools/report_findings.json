{
  "name": "report_findings",
  "description": "Report review findings to the client UI. Copy findings from the review findings artifact. A follow-up report after fixes must include the complete same finding set with outcomes.",
  "parametersJsonSchema": {
    "type": "object",
    "properties": {
      "level": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "findings": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "severity": {"type": "string", "enum": ["Critical", "Suggestion", "Nice to have"]},
            "confidence": {"type": "string", "enum": ["high", "low"]},
            "source": {"type": "string", "enum": ["review", "build", "test", "probe", "lint"]},
            "file": {"type": "string", "maxLength": 4096},
            "line": {"type": "number"},
            "summary": {"type": "string"},
            "shortSummary": {"type": "string", "maxLength": 60},
            "failureScenario": {"type": "string"},
            "category": {"type": "string"},
            "outcome": {"type": "string", "enum": ["fixed", "skipped", "no_change_needed"]},
            "outcomeNote": {"type": "string"}
          },
          "required": ["severity", "file", "summary", "failureScenario"],
          "additionalProperties": false
        }
      }
    },
    "required": ["findings"],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
